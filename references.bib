@article{Powels1992,
	abstract = {Catha Edulis Forsk. (Arabic: Qat) is a plant belonging to the family
	of the Celastraceae, the fresh leaves of which are chewed in Yemen
	as a stimulant. Although Qat has been described under different aspects,
	the derivation of the term has not previously been considered. The
	word Qat, hitherto considered as Arabic, is found in Persian as well
	as in the Ethiosemitic & Cushitic languages. The plant itself is
	endogenous in Africa & came to the Arabic peninsula as a result of
	the Islamization of the Ethiopian highland during the first half
	of the thirteenth century. The name Qat, however, is not found in
	the African countries of origin. There, the plant is mostly given
	names from Bantu languages, proving that the phonetic variants of
	Qat occurring in Ethiosemitic & Cushitic languages are loanwords
	from Arabic. Explanations for the fact that the plant came from the
	Ethiopian highland to Yemen but no endogenous names for it exist
	in Ethiopia are provided. It is noted that out of numerous medieval
	works on pharmacology, Qat is mentioned by only two authors. Examination
	of these two sources proves that the substance described in one of
	them must be of eastern origin, whereas Catha Edulis Forsk. is endogenous
	in Africa. Arabic Qat is derived from Malayalam kattu, a Catechu-extract
	exported from the Malabar coast. The form transmitted into the Semitic
	& Cushitic languages was kattu. The Arabic script as a consonantal
	script does not designate vowels & doubling of consonants. Thus Malayalam
	kattu became Arabic Qat. 15 References. Modified AA},
	author = {Sylvia Powels},
	isbn = {0170-026X},
	journal = {Zeitschrift fur arabische Linguistik/Journal of Arabic Linguistics /Journal de Linguistique Arabe},
	keywords = {Diachronic Linguistics (18500); Arabic (03750); Etymology (23250); Borrowing (09300); Arabic Qat derivation/origin},
	language = {German},
	note = {CD: ZALIEK},
	pages = {7-20},
	title = {On the Origin of the Word Qat [Catha Edulis Forsk.]},
	volume = {24},
	year = {1992}}

