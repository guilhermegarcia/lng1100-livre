@article{Mansour1988,
	abstract = {Vowel ditribution in the Judeo-Arabic dialect of Baghdad is discussed
	as a contribution to Haim Blanc's general discussion of Baghdad dialects
	(Communal Dialects in Baghdad, Cambridge, Mass, 1964). The distribution
	of the dialect's 11 (5 long & 6 short) vowels in various types of
	syllables (stressed final & nonfinal, unstressed syllables following
	& preceding the stressed syllable) is specified, & their phonemic
	contrast in the same phonetic context is examined. It is concluded
	that long vowels occur in stressed syllables of every kind: open,
	closed, final, & nonfinal, with the exception of u, which does not
	occur in a final open syllable. Long vowels do not as a rule occur
	in unstressed syllables, & whenever a long vowel has, as a result
	of stress shift, become unstressed, it has also been shortened. Short
	vowels of this dialect do not occur in a stressed final syllable.
	1 Table. Z. Dubiel},
	author = {Jacob Mansour},
	isbn = {0170-026X},
	journal = {Zeitschrift fur arabische Linguistik/Journal of Arabic Linguistics /Journal de Linguistique Arabe},
