@article{Kirchhoff2005,
	abstract = {Many of the world's languages have a multitude of dialects which differ
	considerably from each other in their linguistic properties. Dialects
	are often spoken rather than written varieties; the development of
	automatic speech recognition systems for dialects therefore requires
	the collection & transcription of large amounts of dialectal speech.
	In those cases where sufficient training data is not available, acoustic
	&/or language models may benefit from additional data from different
	though related dialects. In this study we investigate the feasibility
	of cross-dialectal data sharing for acoustic modeling using two different
	varieties of Arabic, Modern Standard Arabic & Egyptian Colloquial
	Arabic. An obstacle to this type of data sharing is the Arabic writing
	system, which lacks short vowels & other phonetic information. We
	address this problem by developing automatic procedures to restore
	the missing information based on morphological, contextual & acoustic
	knowledge. These procedures are evaluated with respect to the relative
	contributions of different knowledge sources & with respect to their
	effect on the overall recognition system. We demonstrate that cross-dialectal
	data sharing leads to significant reductions in word error rate.
	11 Tables, 3 Figures, 26 References. [Copyright 2005 Elsevier B.V.]},
	author = {Katrin Kirchhoff and Dimitra Vergyri},
	isbn = {0167-6393},
	journal = {Speech Communication},
	keywords = {Arabic (03750); Dialects (18750); Acoustics (00200); Voice Recognition (95250); Writing Systems (98800); Morphological Analysis (55380); Context (15250); Computer Generated Language Analysis (14300)},
	language = {English},
	month = {May},
	note = {CD: SCOMDH},
	number = {1},
	pages = {37-51},
	title = {Cross-Dialectal Data Sharing for Acoustic Modeling in Arabic Speech Recognition},
	volume = {46},
	year = {2005}}

