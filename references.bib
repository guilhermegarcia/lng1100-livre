	language = {English},
	pages = {107-118},
	publisher = {John Benjamins Publishing Company},
	series = {Perspectives on Arabic Linguistics Vii: Papers from the Seventh Annual Symposium on Arabic Linguistics},
	title = {Experimental Investigations of Arabic Syllable Structure},
	year = {1995}}

