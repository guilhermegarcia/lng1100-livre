@article{Otake1988,
	abstract = {Previous studies on whether the mora has any acoustic reality in Japanese,
	which has been described as a mora-timed lang, are discussed. An
	experiment is reported in which a possible compensation effect in
	mora timing was examined. Ss were native speakers of Japanese, native
	speakers of Eng who had studied Japanese for less than 6 months,
	& native speakers of Arabic (N = 9 each group). Two types of test
	words were used: two-syllable nonsense words used in an earlier study
	by R. F. Port et al (see LLBA 17/2, 8303434), & test words derived
	by adding the syllable /ta/ at the beginning & the syllable /ka/
	at the end of each nonsense word. Ss were told that these words were
	nonsense Japanese words & Arabic words. Tense words were embedded
	in Japanese or Arabic carrier sentences. Ss practiced & then read
	each word. Measurements included duration of voice onset time (VOT)
	for /b/ & /t/, duration of closure for /b/, /t/, /d/, /k/, & flap
	/r/, & duration of /s/, & duration of all vowels. A compensation
	effect was found for all Ss, as all CV syllables tended to have the
	same length. It is suggested that if other effects are disregarded,
	the durational pattern of CV syllables is determined by the duration
	of a cons & a vowel plus the contextual effect. 6 Figures, 9 References.
	B. Annesser Murray},
	author = {Takashi Otake},
	isbn = {0911-0402},
	journal = {The Bulletin, The Phonetic Society of Japan},
	keywords = {Phonetics (ph9); Japanese (ja2); Nonsense Words (no3); Afro-Asiatic Languages (af2); Vowel (vo4); Consonant (co14); Acoustic Phonetics (ac2); Arabic/Japanese mora, acoustic reality/possible compensation effect in timing; native Arabic/English/Japanese speakers},
	language = {English},
	month = {Dec},
	note = {CD: BPSJAV},
	pages = {19-24},
	title = {A Temporal Compensation Effect in Arabic and Japanese},
	volume = {189},
	year = {1988}}

