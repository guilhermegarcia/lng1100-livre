@article{Port1980,
	abstract = {The extent to which vowels adjacent to longer & shorter apical conss
	would compensate for the cons durations was explored. In experiment
	1, Arabic words with /t, d, r/ preceded by a stressed vowel were
	examined as produced at slow, neutral, & fast tempos (N = 5 adult
	Arabic speakers) - little evidence of timing compensation was found.
	In experiment 2 (N = 13 adult Japanese speakers), cons-vowel-cons-vowel
	words containing either the longest vowel /a/ or the shortest vowel
	/u/ & the apical conss /s, t, d, r/ were produced. Japanese vowels
	on both sides of a cons varied inversely with the cons, & the cons
	construction duration varied inversely with the inherent vowel durations
	- the duration of the test words scarcely changed at all. Results
	support the notion that Japanese morae have cons durations although
	they undermine the definition of the mora as a simple cons-vowel
	unit. Rhythmic structures in speech need not be thought of as constructed
	by the perceiver; they may also be present in the acoustic signal
	itself. The existence of lang-specific timing rules that cannot be
	captured in segmental terms is postulated. 2 Tables, 2 Figures. Modified
	HA},
	author = {Robert F. Port and Salman Al-Ani and Shosaku Maeda},
	isbn = {0031-8388},
	journal = {Phonetica},
	keywords = {Phonetics (ph9); Language Universals (la8); Time, Duration (ti1); Vowel (vo4); Consonant (co14); temporal compensations, vowel/consonant lengths; universal phonetics; Arabic, Japanese speakers},
	language = {English},
	note = {CD: PHNTAW},
	number = {4},
	pages = {235-252},
	title = {Temporal Compensation and Universal Phonetics},
	volume = {37},
	year = {1980}}

@article{Port1983,
	abstract = {Features of phonetic timing in the English of 12 speakers of Jordanian
	Arabic were studied by having these Ss & 5 monolingual speakers of
	American English read monosyllabic words embedded in a carrier sentence.
	Recordings of voice onset time (VOT) for initial voiceless stops
	& of vowel duration & final cons closure durations of word-final
	lax & tense stops suggests that Arab speakers have trouble pronouncing
	English /p/ due to implementation rules, rather than the combination
	of abstract distinctive features. Implementation rules of vowels
	& cons closure durations correlated with tensity contrast were also
	more difficult to acquire than the American English rule for producing
	the intervocal flap /t, d/. These results support the hypothesis
	that distinctive features are fairly plastic, but that implementation
	rules are more difficult to alter in adults. 3 Tables, 33 References.
	I. Mielonen},
	author = {Robert F. Port and Fares Mousa Mitleb},
	isbn = {0095-4470},
	journal = {Journal of Phonetics},
	keywords = {Phonetics (ph9); Second Language Learning (se3); English (en2); Afro-Asiatic Languages (af2); Distinctive Feature Theory (di8); Phonation (ph3); English phonetic timing features; voice onset time recordings, pronunciation problems, implementation rules; Jordanian Arabic speakers},
	language = {English},
	month = {July},
	note = {CD: JPHNB9},
	number = {3},
	pages = {219-229},
	title = {Segmental Features and Implementation in Acquisition of English by Arabic Speakers},
	volume = {11},
	year = {1983}}

