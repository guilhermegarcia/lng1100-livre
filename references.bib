@article{Wolf1985,
	abstract = {The replacement of k with a glottal stop (found under different conditions
	& with different effects in nine Barbarician dialects) is examined
	in relation to the position of the original k: (1) in medial position
	- intervocalic -c-, -cc-; postconsonantal -lc-, -rc-, -sc-, -nc-;
	preconsonantal -cl-, -cr-, -x-, -ct-, -cj-, -qu-; interconsonantal
	-lcl-, -lcr-, -rcl-, -rcr-, (-)scl-, (-)scr-, -ncl-, -ncr-, & (2)
	in initial position - prevocalic c-; preconsonantal cl-, cr-, qu-.
	The development of k in Romance languages is compared to that in
	Arabic, where in some dialects the uvular plosive q was moved either
	backward (to a glottal stop) or forward (to a velar plosive); in
	other dialects the development of k depended on the surrounding vowels
	(k < c/c with front vowels, no change with back vowels). But while
	the Arab dialects with unvoiced affricates represent a minority,
	a minority of Romance dialects (Logudoresian & Nuoresian) retained
	velar plosives & only Barbarician changed k into a glottal stop.
	2 Figures, 43 References. I. Kocher},
	author = {Heinz Jurgen Wolf},
	isbn = {0049-8661},
	journal = {Zeitschrift fur romanische Philologie},
	keywords = {Diachronic Linguistics (di1); Romance Languages (ro1); Afro-Asiatic Languages (af2); Sound Change (so3); Sardinian phonetic chronology, Orgosolo glottal stop; phonetic change analysis; Arabic compared},
	language = {German},
	note = {CD: ZRMPAP},
	number = {3-4},
	pages = {269-311},
	title = {Glottal Stop in Orgosolo: Thoughts on Sardinian Phonetic Chronology},
