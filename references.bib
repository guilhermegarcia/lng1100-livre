@incollection{Znagui1994,
	abstract = {An acoustic phonetic classification is proposed for Standard Arabic
	vowels in terms of CV syllable structure, based on the criterion
	of tongue advancement/retraction. An experiment involving an adaptation
	of Shinji Maeda's model of articulatory synthesis (see LLBA 25/4,
	9109693) was conducted to produce evidence of the functional role
	of the tongue in Arabic vowel production. Data were recorded sentences
	containing words composed of vowels in contact with various consonants,
	spoken by native Arabic speakers from Morocco, Algeria, & Tunisia
	(N unspecified). Results of spectrographic analysis showed a distinction
	between two classes of vowels based on tongue movement. A binary
	phonetic classification of Arabic vowels based on tongue advancement
	/retraction is proposed. 1 Table, 3 Figures, 26 References. C. Brennan},
