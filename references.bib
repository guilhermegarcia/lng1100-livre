@article{Jong1999a,
	abstract = {Phonetic correlates of stress & word-final juncture are investigated
	in Amman (Jordan) Arabic (N = 4 females). Ten tetrasyllabic words
	containing a /da/ sequence in different conditions of stress, word
	position, & syllable weight were produced in five prosodic conditions
	- isolation & final vs nonfinal position in questions vs statements.
	Measurements of vowel durations, midpoint fundamental frequencies
	(F0), & syllable-center first formants (F1) were subjected to analyses
	of variance for factors including speaker, word position, stress,
	syllable weight, & boundary strength. Results show word-final lengthening
	effects intermediate between those of phrase-internal & -final positions
	in English; smaller stress effects on duration correlated occasionally
	with higher F1, & a consistent small lengthening in penultimate position
	did not correlate with F1. Pitch accents were linked to stressed
	syllables, & phrasal junctures were marked by pitch & lengthening.
	4 Tables, 11 Figures, 43 References. J. Hitchcock},
