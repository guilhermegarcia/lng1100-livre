@article{Owens1993,
	abstract = {The process of 'imala, ie, the fronting of Arabic a in an environment
	containing a high vowel, is explored in a comparative study of Eastern
	Libyan Arabic (ELA), other modern dialects, & the statements of early
	Arab grammarians. Conditions are specified for the process, which
	in ELA yields i(schwa); it is argued that this realization corresponds
	to the grammarian Sibawaih's phonetic description & that only a small
	change in conditioning separates the distribution of 'imala in Sibawaih's
	account from that found in ELA. It is suggested that ELA & Maltese
	may be relic areas retaining a formerly more widespread fronting
