@article{Kiesler1995,
	abstract = {The relevance of research on the phonetic evolution of Arabisms in
	languages for verification of etymologies, comparative analysis,
	diachronic studies, or identification of borrowing routes is noted.
	The history of systematic research in the phonetic adaptation of
	Arabisms into Catalan, along with the principal authors & their publications,
	is described. Assimilation of stressed & unstressed vowels & consonantal
	phonemes of Arabic loanwords into Catalan is studied in detail, &
	it is concluded that only about 33% of Hispano-Arabic phonemes were
	replaced with Catalan sounds in a regular fashion. The remaining
	Arabic sounds were adapted in a modified way so that the phonetics
	of Catalan Arabisms is somewhat confusing & blurred. The prevalent
	replacement tendencies for the various Hispano-Arabic sounds are
	identified. 1 Index, 43 References. Z. Dubiel},
