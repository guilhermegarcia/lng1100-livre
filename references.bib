@misc{Kang1994,
	abstract = {In Korean, distinctions between affixes, clitics and words have never
	been clearly defined. In this paper, based on the previous works
	on the phonological rules and prosodic structure in Korean, I establish
	clear-cut measures for affixhood, clitichood and wordhood in terms
	of their phonological rule application. I take three controversial
	cases into consideration: case markers, nouns following an adnominal
	verbal morpheme (u)l, and nouns following a numeral quantifier. Under
	the framework of Lexical phonology, I prove that they are all subject
	to lexical rule application and so they have to be derived in the
	lexicon. Since clitics are available to phonological rule application
	only after syntactic concatenation, they cannot undergo lexical rule
	application. So I conclude that so far no clitic category has been
	detected in Korean.},
	author = {Kang, Yoonjung},
	keywords = {Korean, clitic, prosody, affix, Lexical Phonology},
	timestamp = {2005.12.29},
	title = {'{P}honological {C}lassification of {A}ffixes, {C}litics and {W}ords in {K}orean: {P}honological {E}vidence {A}gainst the {C}litic {C}ategory in {K}orean'},
	year = {1994}}

