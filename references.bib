@article{Zomorrodian2003,
	abstract = {Xaje Nasiroddin Tusi, a renowned Iranian scholar of the 7th century
	AH (14th century AD) who specialized in logic, philosophy, mathematics,
	morals, & literature, wrote a book on rhymes & prosody that may help
	to clarify phonological & phonetic issues in the history of Persian.
	In the prosodic section of his work Me'yar ol-as'ar (Criteria of
	Poetry), he notes that the velarized (emphatic), postvelar, & pharyngeal
	consonants of Arabic do not exist in Persian, thereby confirming
	that Persian & Arabic shared voiced interdental & velar fricatives
	& [w], three phonemes that no longer exist in Persian. Other sounds
	noted by Nasiroddin Tusi as proper to Persian & lost since his time
	are long mid vowels, [xw], & the sound represented by qaf with three
	superscript dots. Adapted from the source document},
	author = {Reza Zomorrodian},
	isbn = {0259-9082},
	journal = {Majalle-ye Zabanshenasi/Iranian Journal of Linguistics},
