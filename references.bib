@article{Lindua1990,
	abstract = {Some phonetic differences found in the production of diphthongs are
	examined in a pilot study of the diphthongs /ai/ & /au/, the most
	frequently found diphthongs in the languages of the world. Acoustic
	properties of the productions of these two diphthongs by speakers
	of Arabic, Hausa, Chinese, & English were examined by means of spectrograms.
	It is shown that transition durations differ, even within a single
	language. The relative amount of transition may be related to the
	system of vowels & diphthongs in the particular language. Additional
	studies are called for. 5 Figures, 3 References. B. Annesser Murray},
