@article{Rajouani1987,
	abstract = {An investigation of the pharyngealization by analysis/synthesis is
	realized as a contribution to the development of synthesis-by-rule
	system for Arabic. The acoustic parametrization of the Arabic pharyngealized
	conss /s/,/d/,/t/,/(eth)/ are described using a formant synthesizer.
	Acoustical studies showed that the usual description of the Arabic
	vowel system as a set of three short vowels & their three long counterparts
	is inadequate. A system of 12 vowels including six pharyngealized
	ones is defined according to phonetic & phonological facts. The rules
	dealing with the extension of pharyngealization in connected speech
